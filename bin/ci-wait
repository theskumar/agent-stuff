#!/usr/bin/env bash
# ci-wait: wait for a PR's checks, then print the failing job logs.
#   ci-wait            # PR for the current branch
#   ci-wait 123        # PR number, URL or branch
# Exit code: 0 when all checks pass, 1 when any fail.
set -uo pipefail

pr="${1:-}"
if gh pr checks $pr --watch --interval 20 >/dev/null 2>&1; then
  gh pr checks $pr
  echo "ci-wait: all checks passed"
  exit 0
fi

gh pr checks $pr
echo
echo "ci-wait: failing jobs"
branch="$(gh pr view $pr --json headRefName -q .headRefName)"
runs="$(gh run list --branch "$branch" --limit 20 --json databaseId,conclusion \
  -q '.[] | select(.conclusion=="failure") | .databaseId' | head -5)"
for id in $runs; do
  echo "===== run $id ====="
  gh run view "$id" --log-failed 2>/dev/null | tail -n "${CI_WAIT_LINES:-80}"
done
exit 1
