#!/usr/bin/env node
// Eval stub for the Notion CLI `ntn`. Logs every call to <work>/.ntn-log.jsonl and prints a canned reply.
// It never talks to Notion. Help, spec, docs and `api ls` go to the real ntn with a fake token and a dead API host.
const fs = require("node:fs");
const path = require("node:path");
const { spawnSync } = require("node:child_process");

const here = path.dirname(fs.realpathSync(__filename));
const LOG = path.join(path.dirname(here), "ntn-log.jsonl"); // <stub>/bin/ntn logs to <stub>/ntn-log.jsonl
const REAL = "/Users/theskumar/.local/bin/ntn";
const args = process.argv.slice(2);

const PAGE = "1a2b3c4d-5e6f-4071-8293-a4b5c6d7e8f9"; // Q3 Plan
const TASK = "5e6f7081-92a3-4b4c-9d5e-6f708192a3b4"; // task row "Fix login bug"
const PARENT = "6f708192-a3b4-4c5d-8e6f-708192a3b4c5"; // Projects
const DB = "3c4d5e6f-7a8b-49c0-a1b2-c3d4e5f60718";
const DS = "4d5e6f70-8192-4a3b-8c4d-5e6f70819203";
const UPLOAD = "7a8b9c0d-1e2f-4a3b-9c4d-5e6f7a8b9c0d";
const B = {
  goals: "b1000000-0000-4000-8000-000000000001",
  grow: "b1000000-0000-4000-8000-000000000002",
  owner: "b1000000-0000-4000-8000-000000000003",
  launch: "b1000000-0000-4000-8000-000000000004",
  timeline: "b1000000-0000-4000-8000-000000000005",
  beta: "b1000000-0000-4000-8000-000000000006",
};
const norm = (s) => {
  const m = String(s || "").replace(/-/g, "").match(/[0-9a-f]{32}/i);
  if (!m) return String(s || "");
  const h = m[0].toLowerCase();
  return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;
};

const isHelp = args.some((a) => ["--help", "-h", "--spec", "--docs"].includes(a)) || args[0] === "help" || (args[0] === "api" && args[1] === "ls");
if (isHelp) {
  log({ args, kind: "help" });
  const r = spawnSync(REAL, args, {
    stdio: "inherit",
    env: { ...process.env, NOTION_API_TOKEN: "eval-fake-token", NOTION_API_BASE_URL: "http://127.0.0.1:9" },
  });
  process.exit(r.status ?? 1);
}
if (args[0] === "--version" || args[0] === "-V") { log({ args, kind: "version" }); console.log("ntn 0.16.0"); process.exit(0); }

function log(rec) { fs.appendFileSync(LOG, JSON.stringify({ t: Date.now(), cwd: process.cwd(), ...rec }) + "\n"); }
function readStdin(ms = 1500) {
  return new Promise((resolve) => {
    if (process.stdin.isTTY) return resolve("");
    const chunks = [];
    const done = () => resolve(Buffer.concat(chunks).toString("utf8"));
    const t = setTimeout(() => { process.stdin.pause(); done(); }, ms);
    process.stdin.on("data", (c) => chunks.push(c));
    process.stdin.on("end", () => { clearTimeout(t); done(); });
    process.stdin.on("error", () => { clearTimeout(t); done(); });
  });
}
const flag = (name) => { const i = args.indexOf(name); return i >= 0 ? args[i + 1] : undefined; };
const has = (name) => args.includes(name);
const fail = (msg, code = 1) => { console.error(`error: ${msg}`); process.exitCode = code; };
const out = (v) => console.log(typeof v === "string" ? v : JSON.stringify(v, null, 2));

const rt = (s) => [{ type: "text", text: { content: s, link: null }, plain_text: s, annotations: { bold: false } }];
const blk = (id, type, text) => ({ object: "block", id, type, has_children: false, in_trash: false, [type]: type === "divider" ? {} : { rich_text: rt(text) } });
const PAGE_BLOCKS = [
  blk(B.goals, "heading_2", "Goals"),
  blk(B.grow, "bulleted_list_item", "Grow revenue 15%"),
  blk(B.owner, "paragraph", "Owner: TBD"),
  blk(B.launch, "paragraph", "Launch date: Nov 14"),
  blk(B.timeline, "heading_2", "Timeline"),
  blk(B.beta, "bulleted_list_item", "Beta in October"),
];
const PAGE_MD = "# Q3 Plan\n\n## Goals\n\n- Grow revenue 15%\n\nOwner: TBD\n\nLaunch date: Nov 14\n\n## Timeline\n\n- Beta in October\n";
const TASK_MD = "Fix the login bug reported by the mobile team.\n";
const props = {
  task: {
    Name: { id: "title", type: "title", title: rt("Fix login bug") },
    Status: { id: "st%3A1", type: "status", status: { id: "s2", name: "Blocked", color: "red" } },
    Assignee: { id: "as%3A1", type: "people", people: [] },
  },
  page: { title: { id: "title", type: "title", title: rt("Q3 Plan") } },
};
const pageObj = (id) => {
  const t = id === TASK ? "task" : "page";
  return {
    object: "page", id, url: `https://www.notion.so/${t === "task" ? "Fix-login-bug" : "Q3-Plan"}-${id.replace(/-/g, "")}`,
    parent: t === "task" ? { type: "data_source_id", data_source_id: DS, database_id: DB } : { type: "workspace", workspace: true },
    properties: props[t], in_trash: false,
  };
};
const ROWS = [
  { id: TASK, title: "Fix login bug", status: "Blocked" },
  { id: "5e6f7081-92a3-4b4c-9d5e-6f708192a3b5", title: "Ship onboarding v2", status: "In progress" },
  { id: "5e6f7081-92a3-4b4c-9d5e-6f708192a3b6", title: "Migrate billing DB", status: "Blocked" },
  { id: "5e6f7081-92a3-4b4c-9d5e-6f708192a3b7", title: "Write Q3 retro", status: "Done" },
];
const rowObj = (r) => ({ object: "page", id: r.id, url: `https://www.notion.so/${r.title.replace(/ /g, "-")}-${r.id.replace(/-/g, "")}`, properties: { Name: { type: "title", title: rt(r.title) }, Status: { type: "status", status: { name: r.status } } } });
function filterRows(filter) {
  const f = typeof filter === "string" ? filter : JSON.stringify(filter || "");
  const m = f.match(/"(?:equals|does_not_equal)"\s*:\s*"([^"]+)"/);
  if (!m) return ROWS;
  const neg = /does_not_equal/.test(f);
  return ROWS.filter((r) => (r.status === m[1]) !== neg);
}

const commentObj = (body) => ({ object: "comment", id: "c1000000-0000-4000-8000-000000000001", parent: { type: "page_id", page_id: PAGE }, discussion_id: "d1000000-0000-4000-8000-000000000001", rich_text: rt(String(body?.markdown ?? "comment")) });

function parseInline(rest) {
  // ntn api inline inputs: path=value, path:=json, name==value, Header:Value
  const body = {}; const query = {};
  for (const a of rest) {
    let m;
    if ((m = a.match(/^([^=:]+):=(.*)$/s))) { try { body[m[1]] = JSON.parse(m[2]); } catch { body[m[1]] = m[2]; } }
    else if ((m = a.match(/^([^=]+)==(.*)$/s))) query[m[1]] = m[2];
    else if ((m = a.match(/^([^=:]+)=(.*)$/s))) body[m[1]] = m[2];
  }
  return { body, query };
}

async function api() {
  let p = args[1] || "";
  const rest = [];
  let method = null, data = null, file = null;
  for (let i = 2; i < args.length; i++) {
    const a = args[i];
    if (a === "-X" || a === "--method") method = args[++i];
    else if (a === "-d" || a === "--data") data = args[++i];
    else if (a === "--notion-version") i++;
    else if (a === "--file") file = args[++i];
    else rest.push(a);
  }
  const inline = parseInline(rest);
  let stdin = "";
  if (data == null && !Object.keys(inline.body).length && !file) stdin = await readStdin(800);
  let body = null;
  const raw = data ?? (stdin.trim() ? stdin : null);
  if (raw != null) { try { body = JSON.parse(raw); } catch { log({ args, stdin, kind: "action", error: "bad json" }); return fail("Request body is not valid JSON"); } }
  else if (Object.keys(inline.body).length) body = inline.body;
  method = (method || (body || file ? "POST" : "GET")).toUpperCase();
  p = p.replace(/^\/+/, "").replace(/^v1\//, "");
  const [pathOnly, qs] = p.split("?");
  log({ args, stdin, kind: "action", api: { method, path: pathOnly, body, query: { ...Object.fromEntries(new URLSearchParams(qs || "")), ...inline.query } } });
  const seg = pathOnly.split("/");
  const id = norm(seg[1]);
  if (seg[0] === "users" && seg[1] === "me") return out({ object: "user", id: "u1", type: "bot", name: "Notion CLI", bot: { owner: { type: "user", user: { name: "Eval User" } } } });
  if (seg[0] === "users") return fail("Public API request failed (403 Forbidden restricted_resource): Personal access tokens cannot list users");
  if (seg[0] === "blocks" && seg[2] === "children") {
    if (method === "GET") return out({ object: "list", results: id === PAGE ? PAGE_BLOCKS : [blk("b2000000-0000-4000-8000-000000000001", "paragraph", TASK_MD.trim())], has_more: false, next_cursor: null });
    if (method === "PATCH") {
      if (body?.after && body?.position) return fail("Public API request failed (400 Bad Request validation_error): body.after and body.position should not both be present");
      const kids = (body?.children || []).map((c, i) => ({ ...c, object: "block", id: `b3000000-0000-4000-8000-00000000000${i}` }));
      return out({ object: "list", results: kids, has_more: false, next_cursor: null });
    }
  }
  if (seg[0] === "blocks" && seg.length === 2) {
    const b = PAGE_BLOCKS.find((x) => x.id === id) || blk(id, "paragraph", "");
    if (method === "GET") return out(b);
    if (method === "PATCH") return out({ ...b, ...(body || {}) });
    if (method === "DELETE") return out({ ...b, in_trash: true, archived: true });
  }
  if (seg[0] === "pages" && seg[2] === "markdown") {
    if (method === "GET") return out({ object: "page_markdown", id, markdown: id === TASK ? TASK_MD : PAGE_MD, truncated: false, unknown_block_ids: [] });
    if (method === "PATCH") return out({ object: "page_markdown", id, markdown: PAGE_MD + "\n<!-- updated -->\n", truncated: false, unknown_block_ids: [] });
  }
  if (seg[0] === "pages" && seg[2] === "properties") return out({ object: "property_item", type: "status", status: props.task.Status.status });
  if (seg[0] === "pages" && seg.length === 2) {
    if (method === "GET") return out(pageObj(id));
    if (method === "PATCH") return out({ ...pageObj(id), ...(body?.properties ? { properties: { ...pageObj(id).properties, ...body.properties } } : {}) });
  }
  if (seg[0] === "pages" && seg.length === 1 && method === "POST") return out({ ...pageObj("8a9b0c1d-2e3f-4a5b-8c6d-7e8f9a0b1c2d"), url: "https://www.notion.so/New-page-8a9b0c1d2e3f4a5b8c6d7e8f9a0b1c2d" });
  if (seg[0] === "comments") {
    if (method === "POST") return out(commentObj(body));
    return out({ object: "list", results: [commentObj({ markdown: "Can we move the beta earlier?" })], has_more: false, next_cursor: null });
  }
  if (seg[0] === "search") return out({ object: "list", results: [{ ...pageObj(PAGE), url: `https://www.notion.so/Q3-Revenue-Plan-${PAGE.replace(/-/g, "")}`, properties: { title: { type: "title", title: rt("Q3 Revenue Plan") } } }], has_more: false, next_cursor: null });
  if (seg[0] === "databases") return out({ object: "database", id: DB, title: rt("Tasks"), data_sources: [{ id: DS, name: "Tasks" }] });
  if (seg[0] === "data_sources" && seg[2] === "query") {
    if (id !== DS) return fail(`Public API request failed (404 Not Found object_not_found): Could not find data_source with ID: ${id}. Make sure the relevant pages and databases are shared with your integration.`);
    return out({ object: "list", results: filterRows(body?.filter).map(rowObj), has_more: false, next_cursor: null });
  }
  if (seg[0] === "data_sources") return out({ object: "data_source", id: DS, title: rt("Tasks"), properties: { Name: { type: "title" }, Status: { type: "status", status: { options: [{ name: "To-do" }, { name: "In progress" }, { name: "Blocked" }, { name: "Done" }] } } } });
  if (seg[0] === "file_uploads") {
    if (method === "POST" && seg.length === 1) return out({ object: "file_upload", id: UPLOAD, status: "pending", filename: body?.filename ?? null, upload_url: `https://api.notion.com/v1/file_uploads/${UPLOAD}/send` });
    if (seg[2] === "send") return out({ object: "file_upload", id: UPLOAD, status: "uploaded", filename: "diagram.png" });
    return out({ object: "file_upload", id: UPLOAD, status: "uploaded", filename: "diagram.png", content_type: "image/png" });
  }
  return out({ object: "list", results: [], has_more: false, next_cursor: null });
}

async function main() {
  const [cmd, sub] = args;
  if (cmd === "api") return api();
  if (cmd === "whoami") {
    log({ args, kind: "action" });
    if (has("--json")) return out({ object: "user", id: "3754dccd-9d8b-81cd-ba82-002704f0dfa6", type: "bot", name: "Notion CLI" });
    return out("3754dccd-9d8b-81cd-ba82-002704f0dfa6\tNotion CLI\tbot\teval@example.com\t4a623cbf-fd83-41ac-a2dc-6412b050aec1\tAcme\tc951e0c6-8a0e-4c1f-995e-29ca8f6de1c6\tEval User\tperson");
  }
  if (cmd === "doctor") { log({ args, kind: "action" }); return out("ok: logged in to workspace Acme"); }
  if (cmd === "pages") {
    const id = norm(args[2] && !args[2].startsWith("-") ? args[2] : "");
    let stdin = "";
    if ((sub === "create" || sub === "update") && flag("--content") === undefined) stdin = await readStdin();
    log({ args, stdin, kind: "action" });
    if (sub === "get") {
      if (has("--json")) return out({ object: "page_markdown", id, markdown: id === TASK ? TASK_MD : PAGE_MD, truncated: false, unknown_block_ids: [] });
      return out(id === TASK ? `---\nName: Fix login bug\nStatus: Blocked\n---\n${TASK_MD}` : `---\ntitle: Q3 Plan\n---\n${PAGE_MD}`);
    }
    if (sub === "create") {
      const content = flag("--content") ?? stdin;
      if (!content.trim()) return fail("No content provided");
      return out({ object: "page", id: "8a9b0c1d-2e3f-4a5b-8c6d-7e8f9a0b1c2d", url: "https://www.notion.so/New-page-8a9b0c1d2e3f4a5b8c6d7e8f9a0b1c2d" });
    }
    if (sub === "update") return out({ object: "page", id, url: `https://www.notion.so/Q3-Plan-${id.replace(/-/g, "")}` });
    if (sub === "trash") return out(`Trashed page ${id}`);
    return fail(`unrecognized subcommand '${sub}'`, 2);
  }
  if (cmd === "datasources") {
    let stdin = "";
    if (flag("--filter-file") === "-") stdin = await readStdin();
    log({ args, stdin, kind: "action" });
    const id = norm(args[2]);
    if (sub === "resolve") {
      if (id !== DB) return fail(`Public API request failed (404 Not Found object_not_found): Could not find database with ID: ${id}.`);
      return out(has("--json") ? { data_sources: [{ id: DS, name: "Tasks" }] } : `${DS}\tTasks`);
    }
    if (sub === "query") {
      if (id !== DS) return fail(`Public API request failed (404 Not Found object_not_found): Could not find data_source with ID: ${id}. Did you pass a database ID? Use \`ntn datasources resolve <database-id>\`.`);
      let filter = flag("--filter") ?? stdin;
      if (flag("--filter-file") && flag("--filter-file") !== "-") { try { filter = fs.readFileSync(flag("--filter-file"), "utf8"); } catch {} }
      const rows = filterRows(filter);
      if (has("--json")) return out({ object: "list", results: rows.map(rowObj), has_more: false, next_cursor: null });
      return out(rows.map((r) => `${r.id}\t${r.title}\t${r.status}`).join("\n"));
    }
    return fail(`unrecognized subcommand '${sub}'`, 2);
  }
  if (cmd === "files") {
    let size = 0;
    if (sub === "create" && !flag("--external-url")) {
      size = await new Promise((resolve) => {
        if (process.stdin.isTTY) return resolve(0);
        let n = 0; const t = setTimeout(() => resolve(n), 1500);
        process.stdin.on("data", (c) => (n += c.length));
        process.stdin.on("end", () => { clearTimeout(t); resolve(n); });
      });
    }
    log({ args, stdinBytes: size, kind: "action" });
    if (sub === "create") {
      const name = flag("--filename") || "upload.bin";
      const line = `${UPLOAD}\t${name}\tuploaded\t${flag("--content-type") || "application/octet-stream"}\t${size}\t2026-10-27T10:00:00.000Z\t2026-10-27T11:00:00.000Z`;
      return out(has("--json") ? { object: "file_upload", id: UPLOAD, filename: name, status: "uploaded", content_length: size } : line);
    }
    if (sub === "list" || sub === "get") return out(`${UPLOAD}\tdiagram.png\tuploaded\timage/png\t68\t2026-10-27T10:00:00.000Z\t2026-10-27T11:00:00.000Z`);
    return fail(`unrecognized subcommand '${sub}'`, 2);
  }
  if (cmd === "login" || cmd === "logout" || cmd === "update" || cmd === "workers") { log({ args, kind: "action" }); return fail(`${cmd} is disabled in this environment`); }
  log({ args, kind: "invalid" });
  return fail(`unrecognized subcommand '${cmd}'`, 2);
}
main().catch((e) => { fail(e.message); });
